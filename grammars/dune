(library
 (name grammar_tokens)
 (modules grammar_tokens)
 (preprocess (pps ppx_deriving.std)))

; No ppx in the grammar libraries: compare/pp derived there would be
; level-0 values of the grammar's own unit, which its $let code cannot
; call, so the token types are derived in grammar_tokens above.  reex
; and the token library are shift-imported for the $let bodies.
(library
 (name grammars_common)
 (libraries flap reex)
 (static_libraries reex)
 (modules grammars_common)
 (synopsis "Flap example grammars: common code"))

(library
 (name csv_grammar)
 (libraries flap reex grammars_common grammar_tokens)
 (static_libraries reex grammar_tokens)
 (modules csv_grammar)
 (synopsis "Flap example grammars: csv"))

(library
 (name json_grammar)
 (libraries flap reex grammars_common grammar_tokens)
 (static_libraries reex grammar_tokens)
 (modules json_grammar)
 (synopsis "Flap example grammars: json"))

