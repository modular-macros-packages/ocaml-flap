(library
 (name grammar_tokens)
 (modules grammar_tokens)
 (preprocess (pps ppx_deriving.std)))

; The grammar libraries carry macros, so no ppx here; reex and the
; token library are shift-imported for the macro bodies.
(library
 (name grammars_common)
 (libraries flap reex)
 (static_libraries flap.vars reex reex_match.deriv)
 (modules grammars_common)
 (synopsis "Flap example grammars: common code"))

(library
 (name csv_grammar)
 (libraries flap reex grammars_common grammar_tokens)
 (static_libraries flap.vars reex reex_match.deriv grammar_tokens)
 (modules csv_grammar)
 (synopsis "Flap example grammars: csv"))

